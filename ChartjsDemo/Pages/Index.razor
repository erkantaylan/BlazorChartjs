@code {
    private static readonly string PackageVersion = ReadPackageVersion();

    // Read off the component's own assembly rather than hard-coding a string here,
    // so this page cannot advertise a stale version after the next release.
    private static string ReadPackageVersion()
    {
        Assembly assembly = typeof(Chart).Assembly;

        string? version = assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;

        if (string.IsNullOrWhiteSpace(version))
        {
            return assembly.GetName().Version?.ToString(3) ?? "unknown";
        }

        // A CI build appends "+<commit sha>" to the informational version.
        int plus = version.IndexOf('+');
        return plus < 0 ? version : version[..plus];
    }
}
