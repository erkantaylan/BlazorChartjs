<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Erkan.Blazor.Chartjs</PackageId>
    <AssemblyName>Erkan.Blazor.Chartjs</AssemblyName>
    <RootNamespace>Erkan.Blazor.Chartjs</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Erkan Taylan</Authors>
    <Company>Erkan Taylan</Company>
    <Title>Chart.js component for Blazor</Title>
    <Description>Chart.js component for Blazor, for .NET 10 and Chart.js 4.x. Works with Blazor WebAssembly and Blazor Server. Fork of PSC.Blazor.Components.Chartjs by Enrico Rossini.</Description>
    <PackageReleaseNotes>Fork of PSC.Blazor.Components.Chartjs. Targets .NET 10, Chart.js 4.5.1. Adds annotation plugin support, time axes with locale-aware labels, and tick float-noise cleanup after zoom.</PackageReleaseNotes>
    <Copyright>Copyright (c) 2023 Enrico Rossini; fork modifications Copyright (c) 2026 Erkan Taylan</Copyright>
    <PackageTags>chartjs;blazor;charts;blazor-webassembly;blazor-server;blazor-component;wasm;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/erkantaylan/BlazorChartjs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/erkantaylan/BlazorChartjs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackAsTool>False</PackAsTool>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>True</PublishRepositoryUrl>
    <EmbedUntrackedSources>True</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">True</ContinuousIntegrationBuild>
    <!-- The library intentionally ships without XML docs on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-time assets: keep them in the repo but out of the shipped package. -->
    <Content Remove="libman.json" />
    <None Include="libman.json" Pack="false" />
    <Content Remove="psc_ico.ico" />
    <None Include="psc_ico.ico" Pack="false" />
    <None Include="psc_logo.png" Pack="false" />
    <!-- Master artwork for icon.png. Editable source, not a shipped asset. -->
    <None Include="icon.svg" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>
