<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Erkan.Blazor.Chartjs</PackageId>
    <AssemblyName>Erkan.Blazor.Chartjs</AssemblyName>
    <RootNamespace>Erkan.Blazor.Chartjs</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>Erkan Taylan</Authors>
    <Company>Erkan Taylan</Company>
    <Title>Chart.js component for Blazor</Title>
    <Description>Chart.js component for Blazor, for .NET 10 and Chart.js 4.x. Works with Blazor WebAssembly and Blazor Server. Fork of PSC.Blazor.Components.Chartjs by Enrico Rossini.</Description>
    <PackageReleaseNotes>2.0.0 — Adds legend label styling (color, font, box size, padding, point style, text align, border radius), tooltip colors and fonts, and Ticks.Source for time scales. Fixes eighteen properties that were non-nullable value types skipped by the serializer whenever they held the type default, so 0 and false never reached Chart.js: the line and radar Fill, line and scatter Tension, ScatterDataset.ShowLine, nine DataLabels options including Offset and Opacity, the zoom drag and pan Threshold, the zoom wheel Speed, and RadarOptionsElementsLine.BorderWidth — where BorderWidth = 0 now hides the radar outline, which no value could do before. A chart that sets none of them serializes byte-for-byte as it did in 1.0.0, so nothing renders differently. Also fixes null handling across the models: nine string-enum properties threw a NullReferenceException when set to null, six properties wrote a bare null into the config instead of omitting the key, and five dataset colour lists shipped an empty [] on every untouched chart. The wrapper's internal markers (hasFilter, hasLabel, hasCustomTitle, hasCallback, hasAsyncCallback) and the crosshair, groupXAxis and groupYAxis keys no longer reach Chart.js as live options, and the legend filter no longer throws on a chart with an empty data object. Breaking: those eighteen are nullable now, so assigning is unchanged but reading one into a non-nullable local needs ?? 0 or == true; Legend.Position, Legend.TextDirection, Title.Position, Axis.Position and AxesTitle.Align are annotated nullable, which they always were at runtime; the five dataset colour lists are List&lt;string&gt;? with no initializer, so .Add() on one needs an instance first; and AxesTime.Source, LineDataset.Y2AxisId, ScatterDataset.Y2AxisId, LineDataset.FillColor, LineDataset.StrokeColor and *ChartConfig.OnAnimationComplete are removed — each serialized to a key Chart.js 4 does not read. Replacements for all of them, and the full notes, are in CHANGELOG.md: https://github.com/erkantaylan/BlazorChartjs/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) 2023 Enrico Rossini; fork modifications Copyright (c) 2026 Erkan Taylan</Copyright>
    <PackageTags>chartjs;blazor;charts;blazor-webassembly;blazor-server;blazor-component;wasm;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/erkantaylan/BlazorChartjs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/erkantaylan/BlazorChartjs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackAsTool>False</PackAsTool>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>True</PublishRepositoryUrl>
    <EmbedUntrackedSources>True</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">True</ContinuousIntegrationBuild>
    <!-- The library intentionally ships without XML docs on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-time assets: keep them in the repo but out of the shipped package. -->
    <Content Remove="libman.json" />
    <None Include="libman.json" Pack="false" />
    <Content Remove="psc_ico.ico" />
    <None Include="psc_ico.ico" Pack="false" />
    <None Include="psc_logo.png" Pack="false" />
    <!-- Master artwork for icon.png. Editable source, not a shipped asset. -->
    <None Include="icon.svg" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>
