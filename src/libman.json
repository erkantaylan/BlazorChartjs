{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "Chart.js@4.5.1",
      "destination": "wwwroot/lib/Chart.js/"
    },
    {
      "library": "chartjs-plugin-zoom@2.2.0",
      "destination": "wwwroot/lib/chartjs-plugin-zoom/"
    },
    {
      "library": "hammer.js@2.0.8",
      "destination": "wwwroot/lib/hammer.js/"
    },
    {
      "library": "chartjs-plugin-datalabels@2.2.0",
      "destination": "wwwroot/lib/chartjs-plugin-datalabels/"
    },
    {
      "library": "chartjs-plugin-annotation@3.1.0",
      "destination": "wwwroot/lib/chartjs-plugin-annotation/"
    },
    {
      "library": "chartjs-plugin-autocolors@0.3.1",
      "destination": "wwwroot/lib/chartjs-plugin-autocolors/"
    },
    {
      "library": "moment.js@2.30.1",
      "destination": "wwwroot/lib/moment/"
    }
